<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fried’s Hotwm — Wiimotes als Lightguns einrichten"
        Height="760" Width="960"
        MinHeight="680" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="HotwmTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource StatusWarningBrush}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StatusDangerBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource StatusDangerBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="2,0">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,0"/></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource StatusWarningBrush}"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TabBorder" Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource StatusWarningBrush}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="SelectionContent" Margin="5,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" RecognizesAccessKey="True"/>
                                <ToggleButton Grid.Column="1" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="Transparent" BorderThickness="0">
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                        <ScrollViewer CanContentScroll="True" MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource StatusWarningBrush}"/><Setter TargetName="ComboBorder" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboBorder" Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource StatusWarningBrush}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{StaticResource ElevatedBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource StatusWarningBrush}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Tabs / Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="BrandFriendlyMascot" Width="72" Height="72" Stretch="Uniform" Margin="0,0,10,0" AutomationProperties.Name="Freundlicher Begleiter für die Einrichtung"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Fried’s" FontFamily="Georgia" FontSize="14" Foreground="{StaticResource MutedTextBrush}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Hotwm" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <Border Background="{StaticResource ElevatedBrush}" CornerRadius="4" Margin="12,0,0,0" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="TextVersion" FontSize="11" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Wiimotes als Lightguns einrichten" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Relay Quick Status & Power -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="RelayHeaderDot" Width="12" Height="12" Fill="{StaticResource StatusDangerBrush}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="RelayHeaderStatus" Text="Rückstoßdienst inaktiv" FontWeight="Bold" FontSize="12" Foreground="{StaticResource StatusDangerBrush}" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Der hotwm Relay-Dienst verarbeitet Rückstoßereignisse."/>
                    <Button x:Name="BtnHeaderStartRelay" Content="Relay starten" Style="{StaticResource SuccessButton}" Margin="0,0,6,0"/>
                    <Button x:Name="BtnHeaderStopRelay" Content="Relay stoppen" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABS -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <!-- TAB 0: GUIDED SETUP -->
            <TabItem Header="Einrichten">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Willkommen bei Fried’s Hotwm" FontFamily="Georgia" FontSize="21" Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="Wähle deinen Emulator-Ordner. Die erste Prüfung liest nur Informationen und führt dich danach durch die nächsten Schritte." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <GroupBox Header="Installationsordner">
                            <StackPanel Margin="6">
                                <TextBlock Text="Wähle den RetroBat- oder Emulator-Ordner. Hotwm prüft nur, ob der Ordner lesbar ist; Inhalte werden nicht geändert." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextSetupFolder" Grid.Column="0" MinWidth="300" Padding="8,6" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                    <Button x:Name="BtnBrowseSetupFolder" Grid.Column="1" Content="Durchsuchen…" Margin="8,0,0,0"/>
                                    <Button x:Name="BtnValidateSetupFolder" Grid.Column="2" Content="Ordner prüfen" Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="TextSetupFolderStatus" Text="Wähle zuerst einen Ordner." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Einrichtungsmodus">
                            <StackPanel Margin="6">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RadioQuickMode" Content="Schnell" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                                    <RadioButton x:Name="RadioCustomMode" Content="Individuell" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                                    <RadioButton x:Name="RadioExpertMode" Content="Experte" Foreground="{StaticResource TextBrush}"/>
                                </StackPanel>
                                <Border Background="{StaticResource ElevatedBrush}" Padding="10" Margin="0,8,0,0" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock x:Name="TextQuickModeDetail" Text="Empfohlener Ablauf. Gefundene Controller müssen noch einem Spieler zugeordnet und manuell geprüft werden." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock x:Name="TextCustomModeDetail" Text="Wähle gezielt weitere Schritte. Effekte, Tasten und Gunmote-Zuordnungen findest du in den jeweiligen Reitern." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TextExpertModeDetail" Text="Technische Pfade, Gerätekennungen und Prüfnachweise einblenden. Geräteerkennung allein bedeutet nicht, dass ein Spiel funktioniert." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Erkannte Geräte">
                            <StackPanel Margin="6">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Image x:Name="BrandControllerMascot" Grid.Column="0" Width="64" Height="64" Stretch="Uniform" Margin="0,0,8,0" AutomationProperties.Name="Controller-Hinweis"/>
                                    <TextBlock Grid.Column="1" Text="Gefundene Controller müssen noch einem Spieler zugeordnet und geprüft werden. Die Erkennung bestätigt weder Kopplung noch Kalibrierung oder Spielfunktion." TextWrapping="Wrap" Foreground="{StaticResource StatusWarningBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BtnRefreshDiscovery" Content="Geräte neu suchen" Style="{StaticResource AccentButton}"/>
                                    <TextBlock x:Name="TextDiscoveryStatus" Text="Noch nicht geprüft" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="ListDiscoveredDevices" MinHeight="60" MaxHeight="180" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Geführte Prüfung — manuelle Beobachtungen">
                            <StackPanel Margin="6">
                                <TextBlock Text="Hotwm koppelt Controller nicht und kalibriert sie nicht automatisch. Wähle ein Gerät, ordne den gewünschten Spieler zu und bestätige nur Prüfungen, die du selbst durchgeführt hast." TextWrapping="Wrap" Foreground="{StaticResource StatusWarningBrush}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BtnStartWizard" Content="Sitzung starten" Style="{StaticResource AccentButton}"/>
                                    <Button x:Name="BtnRefreshWizard" Content="Neu verbinden / aktualisieren" Margin="8,0,0,0"/>
                                    <Button x:Name="BtnImportWizardState" Content="Verlauf importieren" Margin="8,0,0,0"/>
                                    <Button x:Name="BtnSaveWizardState" Content="Prüfen und speichern" Margin="8,0,0,0"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Image x:Name="BrandSurprisedMascot" Width="44" Height="44" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,8,0" AutomationProperties.Name="Hinweis zu einem aufgetretenen Fehler"/>
                                    <Image x:Name="BrandCelebrateMascot" Width="44" Height="44" Stretch="Uniform" Visibility="Collapsed" Margin="0,0,8,0" AutomationProperties.Name="Alle manuellen Prüfungen wurden bestätigt"/>
                                    <TextBlock x:Name="TextWizardStatus" Grid.Column="1" Text="Prüfe einen Ordner, um zu beginnen." TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbWizardDevice" Grid.Column="0" MinWidth="200" DisplayMemberPath="Label"/>
                                    <ComboBox x:Name="CmbWizardPlayer" Grid.Column="1" Margin="8,0,0,0">
                                    <ComboBoxItem Content="Nicht zugewiesen" Tag="0"/><ComboBoxItem Content="Gewünschter Spieler 1" Tag="1"/><ComboBoxItem Content="Gewünschter Spieler 2" Tag="2"/>
                                    </ComboBox>
                                    <Button x:Name="BtnAssignWizardPlayer" Grid.Column="2" Content="Spieler zuweisen" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Gewünschter Spieler und beobachteter Gunmote-Laufzeitplatz sind getrennte Angaben." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="WizardAttestationActions" Margin="0,0,0,8">
                                    <ComboBox x:Name="CmbWizardRuntimeSlot" Width="145"><ComboBoxItem Content="Beobachteter Platz 1" Tag="1"/><ComboBoxItem Content="Beobachteter Platz 2" Tag="2"/></ComboBox>
                                    <Button x:Name="BtnConfirmRuntimeSlot" Content="Laufzeitplatz bestätigen" Margin="8,0,0,0"/>
                                    <Button x:Name="BtnConfirmCalibration" Content="Kalibrierung bestätigen" Margin="8,0,0,0"/>
                                    <Button x:Name="BtnConfirmAim" Content="Zieltest bestätigen" Margin="8,0,0,0"/>
                                    <Button x:Name="BtnConfirmTrigger" Content="Abzugstest bestätigen" Margin="8,0,0,0"/>
                                </WrapPanel>
                                <ListBox x:Name="ListWizardChecklist" MinHeight="70" MaxHeight="220" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                <TextBlock x:Name="TextWizardExpertDetails" Text="" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Nächste Schritte">
                            <StackPanel Margin="6">
                                <TextBlock Text="Kopple den Controller mit seinen Tasten und den Windows-Bluetooth-Einstellungen. Suche danach erneut und prüfe die Geräteidentität." TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="Spielerzuordnung und Kalibrierung erfolgen manuell. Teste anschließend Ziel und Abzug. Hotwm führt diese Schritte nicht automatisch aus." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TAB 1: STATUS & HARDWARE -->
            <TabItem Header="Status">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <!-- ECOSYSTEM HEALTH -->
                        <GroupBox Header="Hardware &amp; System Components Status">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 1 -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <!-- Relay Status -->
                                    <Border Background="{StaticResource ElevatedBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotRelay" Width="10" Height="10" Fill="{StaticResource StatusDangerBrush}" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="hotwm Relay Engine" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextRelayDetail" Text="Port 8000 listening: No" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextRelayBadge" Text="OFFLINE" Foreground="{StaticResource StatusDangerBrush}" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Gunmote Status -->
                                    <Border Background="{StaticResource ElevatedBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotGunmote" Width="10" Height="10" Fill="{StaticResource StatusWarningBrush}" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Gunmote Process" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextGunmoteDetail" Text="Checking..." FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextGunmoteBadge" Text="UNKNOWN" Foreground="{StaticResource StatusWarningBrush}" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- ViGEmBus Status -->
                                    <Border Background="{StaticResource ElevatedBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotVigem" Width="10" Height="10" Fill="{StaticResource StatusWarningBrush}" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="ViGEmBus Controller Driver" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextVigemDetail" Text="Virtual Gamepad Bus" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextVigemBadge" Text="UNKNOWN" Foreground="{StaticResource StatusWarningBrush}" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Column 2 -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <!-- Wiimote / DolphinBar Status -->
                                    <Border Background="{StaticResource ElevatedBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotWiimote" Width="10" Height="10" Fill="{StaticResource StatusWarningBrush}" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Wiimotes (Bluetooth / DolphinBar)" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextWiimoteDetail" Text="Bluetooth or DolphinBar" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextWiimoteBadge" Text="UNKNOWN" Foreground="{StaticResource StatusWarningBrush}" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Scheduled Task Autostart -->
                                    <Border Background="{StaticResource ElevatedBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotTask" Width="10" Height="10" Fill="{StaticResource StatusWarningBrush}" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Windows Autostart Task" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextTaskDetail" Text="Task: Gunmote Recoil Stretch" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextTaskBadge" Text="CHECKING" Foreground="{StaticResource StatusWarningBrush}" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Kit Integration Status -->
                                    <Border Background="{StaticResource ElevatedBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotKit" Width="10" Height="10" Fill="{StaticResource MutedTextBrush}" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Retro Cabinet Kit API" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextKitDetail" Text="outputs.wiimote_hook (API 1.4+)" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextKitBadge" Text="CHECKING" Foreground="{StaticResource MutedTextBrush}" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- TASK & SYSTEM ACTIONS -->
                        <GroupBox Header="Quick Maintenance Actions">
                            <WrapPanel Margin="4">
                                <Button x:Name="BtnRefreshStatus" Content="⟳ Refresh Status" Margin="0,0,10,6"/>
                                <Button x:Name="BtnInstallTask" Content="⚙ Install Windows Task (Autostart)" Margin="0,0,10,6"/>
                                <Button x:Name="BtnUninstallTask" Content="✕ Remove Windows Task" Margin="0,0,10,6"/>
                                <Button x:Name="BtnQueryKit" Content="🔍 Query Kit Health" Style="{StaticResource AccentButton}" Margin="0,0,10,6"/>
                                <Button x:Name="BtnQueryInputMatrix" Content="🎮 Cabinet Input Matrix (Kit)" Style="{StaticResource AccentButton}" Margin="0,0,10,6"/>
                                <Button x:Name="BtnVerifyOutputSafety" Content="🛡 Output Safety Check (Kit)" Style="{StaticResource AccentButton}" Margin="0,0,10,6"/>
                            </WrapPanel>
                        </GroupBox>

                        <!-- HAPTIC TEST BENCH -->
                        <GroupBox Header="Live Wiimote Haptics Test Bench">
                            <StackPanel Margin="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Player 1 -->
                                    <Border Grid.Column="0" Background="{StaticResource ElevatedBrush}" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Player 1 (Main Gunmote)" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnTestP1Rumble" Content="Send P1 recoil kick (rumble)" Style="{StaticResource AccentButton}" Margin="0,0,8,6"/>
                                                <Button x:Name="BtnTestP1Leds" Content="Cycle P1 LEDs 1 to 4" Margin="0,0,8,6"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Player 2 -->
                                    <Border Grid.Column="1" Background="{StaticResource ElevatedBrush}" CornerRadius="4" Padding="12" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Player 2 (Second Gunmote)" FontWeight="Bold" Foreground="{StaticResource StatusWarningBrush}" FontSize="14" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnTestP2Rumble" Content="Send P2 recoil kick (rumble)" Style="{StaticResource AccentButton}" Margin="0,0,8,6"/>
                                                <Button x:Name="BtnTestP2Leds" Content="Cycle P2 LEDs 1 to 4" Margin="0,0,8,6"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Button x:Name="BtnPingRelay" Content="📡 Ping Relay Socket (Port 8000)" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TextTestFeedback" Text="Ready to test haptics." FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: EDITABLE EFFECT PROFILES -->
            <TabItem Header="Effekte">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <GroupBox Header="Effektprofil">
                            <StackPanel Margin="6">
                                <TextBlock Text="Wähle eine Vorlage, kopiere sie in ein eigenes Profil und passe anschließend gemeinsame Rückstoßwerte sowie Spieleinstellungen an." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Vorlage:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CmbEffectPreset" Grid.Column="1" MinWidth="240" DisplayMemberPath="Name" Padding="6,4"/>
                                </Grid>
                                <TextBlock x:Name="TextEffectPresetDescription" Text="Wähle eine Vorlage für eine kurze Beschreibung." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Profilname:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="TextEffectProfileName" Grid.Column="1" Text="Meine Effekte" Padding="8,5" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                </Grid>
                                <WrapPanel>
                                    <Button x:Name="BtnCopyEffectProfile" Content="Vorlage kopieren" Style="{StaticResource AccentButton}" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnImportEffectProfile" Content="Profil importieren…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnExportEffectProfile" Content="Profil exportieren…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnOpenEffectTuning" Content="Gemeinsame Werte bearbeiten" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="TextEffectProfileStatus" Text="Noch kein eigenes Profil erstellt." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,8"/>
                                <Border Background="{StaticResource ElevatedBrush}" CornerRadius="4" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Gültiger Umfang" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="Effekte gelten für gemeinsame und spielspezifische hotw-Einstellungen. Sie legen keine Effekte pro Spieler fest und bestätigen keine Hardwareausgabe." TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="BtnApplyEffectProfile" Content="Profil prüfen und anwenden…" Style="{StaticResource SuccessButton}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <!-- GLOBAL TUNING -->
                        <GroupBox x:Name="GlobalEffectControls" Header="Gemeinsame Rückstoßwerte">
                            <StackPanel Margin="6">
                                <!-- Recoil Stretch Slider -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Rückstoßdauer:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Slider x:Name="SliderHoldMs" Grid.Column="1" Minimum="80" Maximum="300" Value="150" SmallChange="10" LargeChange="25" TickFrequency="10" IsSnapToTickEnabled="True"/>
                                    <Border Grid.Column="2" Background="{StaticResource ElevatedBrush}" CornerRadius="4" Padding="10,4" Margin="16,0,0,0">
                                        <TextBlock x:Name="TextHoldMsValue" Text="150 ms" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Verlängert kurze MAME-Rückstoßsignale, damit der Wiimote-Motor einen spürbaren Impuls ausgeben kann." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,14"/>

                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                                <!-- Toggles -->
                                <CheckBox x:Name="ChkAmmoDrop" Content="Rückstoß bei sinkendem Munitionsstand" IsChecked="True"/>
                                <CheckBox x:Name="ChkLedLifeBar" Content="Lebensanzeige — Spielergesundheit über Wiimote-LEDs 1 bis 4 anzeigen" IsChecked="True"/>
                                <CheckBox x:Name="ChkTraceLog" Content="Ereignisprotokoll — Rückstoßereignisse in recoil-stretch-trace.log speichern" IsChecked="False"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- GAME PROFILES -->
                        <GroupBox Header="Spielprofile (hotw.json)">
                            <StackPanel Margin="6">
                                <TextBlock Text="Rückstoß und Lebensanzeige für einzelne Spiele anpassen:" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                                <DataGrid x:Name="GridGameProfiles" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          Background="{StaticResource SurfaceBrush}" RowBackground="{StaticResource ElevatedBrush}" AlternatingRowBackground="{StaticResource ElevatedBrush}"
                                          Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                          MaxHeight="260" Margin="0,0,0,12">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource ElevatedBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Spiel" Binding="{Binding Name}" Width="2*" MinWidth="150" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="Rückstoß" Binding="{Binding Rumble}" Width="*" MinWidth="105"/>
                                        <DataGridCheckBoxColumn Header="Lebens-LEDs" Binding="{Binding Leds}" Width="*" MinWidth="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TextConfigSaveStatus" Text="" Foreground="{StaticResource StatusSuccessBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Button x:Name="BtnSaveConfig" Content="Einstellungen prüfen und speichern" Style="{StaticResource SuccessButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Beim Anwenden">
                            <TextBlock Text="Vor dem Speichern wird eine Änderungsvorschau mit Ziel und Werten gezeigt. Abbrechen lässt hotw.json unverändert; die mitgelieferte Vorlage bleibt geschützt." TextWrapping="Wrap" Margin="6" Foreground="{StaticResource MutedTextBrush}"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TAB: SEMANTIC BUTTON PROFILE -->
            <TabItem Header="Tasten &amp; Gunmote">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <GroupBox x:Name="GunmoteLayoutEditor" Header="Gunmote-Steuerung">
                            <StackPanel Margin="6">
                                <TextBlock Text="Bearbeite die OnScreen- und OffScreen-Zuordnungen. Nach deiner Prüfung wird eine Layoutdatei gespeichert, während Gunmote geschlossen ist. Das aktive Layout wird nicht geändert." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Vorlage:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbGunmoteKind" Grid.Column="1" DisplayMemberPath="DisplayTitle" Padding="6,4"/>
                                    <Button x:Name="BtnCopyGunmoteLayout" Grid.Column="2" Content="Vorlage kopieren" Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                                    <Button x:Name="BtnImportGunmoteLayout" Grid.Column="3" Content="Layout importieren…" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="TextGunmoteKindHelp" Text="Wähle eine Vorlage; ihre Originaldatei bleibt unverändert." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Layoutname:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TextGunmoteTitle" Grid.Column="1" Padding="7,4" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                    <TextBox x:Name="TextGunmoteFileName" Grid.Column="2" Width="180" Text="menu_user.json" ToolTip="Neuer JSON-Dateiname im Keymaps-Ordner" Margin="8,0,0,0" Padding="7,4" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Keymaps-Ordner:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TextGunmoteKeymapsDir" Grid.Column="1" Padding="7,4" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                    <Button x:Name="BtnBrowseGunmoteKeymapsDir" Grid.Column="2" Content="Durchsuchen…" Margin="8,0,0,0"/>
                                </Grid>
                                <DataGrid x:Name="GridGunmoteMappings" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          Background="{StaticResource SurfaceBrush}" RowBackground="{StaticResource ElevatedBrush}" AlternatingRowBackground="{StaticResource ElevatedBrush}"
                                          Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}" MaxHeight="360"/>
                                <TextBox x:Name="TextGunmotePreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="200" Visibility="Collapsed" Margin="0,8,0,0" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource MutedTextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                <TextBlock x:Name="TextGunmoteStatus" Text="Kopiere eine Vorlage oder importiere ein vorhandenes Layout." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,4"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button x:Name="BtnSaveGunmoteLayout" Content="Layout prüfen und speichern…" Style="{StaticResource SuccessButton}" Margin="0,0,8,6"/>
                                    <TextBox x:Name="TextGunmoteChooserPath" Width="250" ToolTip="Vorhandene Keymaps.json-Datei" Margin="0,0,8,6" Padding="7,4" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                    <Button x:Name="BtnBrowseGunmoteChooser" Content="Keymaps.json auswählen…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnAddGunmoteChooser" Content="Gespeichertes Layout zur Auswahl hinzufügen…" IsEnabled="False" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock Text="Dies ergänzt nur den Dateinamen in der Layoutauswahl. Es wählt kein Layout aus und ändert nicht das aktive oder Standardlayout." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                            </StackPanel>
                        </GroupBox>
                        <Expander x:Name="ButtonPlanningExpander" Header="Tastenprofil (Planung)" IsExpanded="False" Margin="0,0,0,10">
                            <StackPanel>
                        <GroupBox Header="Tastenwünsche">
                            <StackPanel Margin="6">
                                <TextBlock Text="Diese Liste hält gewünschte Tasten wie Schießen oder Nachladen fest. Sie richtet weder Controller noch Spielbelegung ein." TextWrapping="Wrap" Foreground="{StaticResource StatusWarningBrush}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Vorlage:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CmbButtonTemplate" Grid.Column="1" MinWidth="240" DisplayMemberPath="Name" Padding="6,4"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Profilname:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="TextButtonProfileName" Grid.Column="1" Text="Meine Tastenwünsche" Padding="8,5" Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                                </Grid>
                                <DataGrid x:Name="GridButtonIntents" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          Background="{StaticResource SurfaceBrush}" RowBackground="{StaticResource ElevatedBrush}" AlternatingRowBackground="{StaticResource ElevatedBrush}"
                                          Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}" MaxHeight="260"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="BtnCopyButtonProfile" Content="Vorlage kopieren" Style="{StaticResource AccentButton}" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnImportButtonProfile" Content="Profil importieren…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnExportButtonProfile" Content="Profil exportieren…" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="TextButtonProfileStatus" Text="Noch kein eigenes Tastenprofil erstellt." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Aktueller Integrationsstand">
                            <TextBlock Text="Tastenzuordnungen sind hier nur eine Planung. Eine Übertragung auf Controller oder Spiel erfolgt nicht." TextWrapping="Wrap" Margin="6" Foreground="{StaticResource MutedTextBrush}"/>
                        </GroupBox>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TAB 3: LIVE LOG MONITOR -->
            <TabItem Header="Protokoll">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Recoil Stretch &amp; Relay Event Trace:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="BtnClearLog" Content="Clear" Margin="0,0,8,0"/>
                        <Button x:Name="BtnOpenLogFile" Content="Open Log File in Editor"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                        <TextBox x:Name="TextLogOutput" Background="Transparent" Foreground="{StaticResource MutedTextBrush}"
                                 FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="8"/>
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="TextLogFooter" Text="Logs are written to recoil-stretch-trace.log in the hotwm folder when trace logging is enabled." FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextFooterInfo" Text="hotwm — Hook of the Wiimote • Standalone Engine &amp; Retro Cabinet Kit Extension" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Grid.Column="1" Text="TCP 8000 (Relay) → TCP 8002 (Upstream)" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
