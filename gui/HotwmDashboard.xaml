<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hook of the Wiimote — Dashboard &amp; Recoil Stretcher (hotwm)"
        Height="760" Width="960"
        MinHeight="680" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#12131C"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEFF4"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="BorderBrush" Value="#2D3148"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#24283B"/>
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="BorderBrush" Value="#3B4261"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3B4261"/>
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0D3B4C"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0A3D24"/>
            <Setter Property="BorderBrush" Value="#00E676"/>
            <Setter Property="Foreground" Value="#00E676"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#421419"/>
            <Setter Property="BorderBrush" Value="#FF5252"/>
            <Setter Property="Foreground" Value="#FF5252"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1A1C29"/>
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Setter Property="BorderBrush" Value="#2D3148"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#24283B"/>
                    <Setter Property="Foreground" Value="#00E5FF"/>
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Tabs / Content -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#181A26" BorderBrush="#2D3148" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ HOOK OF THE WIIMOTE" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>
                        <Border Background="#25293E" CornerRadius="4" Margin="12,0,0,0" Padding="6,2">
                            <TextBlock x:Name="TextVersion" FontSize="11" Foreground="#82AAFF" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Wiimote Recoil Stretcher (16ms → 150ms) • Ammo Drop Kick • LED Health Bar Bridge" FontSize="12" Foreground="#8F93A2" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Relay Quick Status & Power -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="RelayHeaderDot" Width="12" Height="12" Fill="#FF5252" Margin="0,0,8,0"/>
                    <TextBlock x:Name="RelayHeaderStatus" Text="RELAY STOPPED" FontWeight="Bold" FontSize="13" Foreground="#FF5252" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="BtnHeaderStartRelay" Content="▶ Start Relay" Style="{StaticResource SuccessButton}" Margin="0,0,6,0"/>
                    <Button x:Name="BtnHeaderStopRelay" Content="■ Stop Relay" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABS -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="#181A26" BorderBrush="#2D3148" BorderThickness="1">
            <!-- TAB 0: GUIDED SETUP -->
            <TabItem Header="Setup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <GroupBox Header="Setup folder">
                            <StackPanel Margin="6">
                                <TextBlock Text="Select a RetroBat or other emulator setup folder. Validation only inspects folder names and never changes the selected folder." TextWrapping="Wrap" Foreground="#8F93A2" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextSetupFolder" Grid.Column="0" MinWidth="300" Padding="8,6" Background="#0E1017" Foreground="#ECEFF4" BorderBrush="#3B4261"/>
                                    <Button x:Name="BtnBrowseSetupFolder" Grid.Column="1" Content="Browse…" Margin="8,0,0,0"/>
                                    <Button x:Name="BtnValidateSetupFolder" Grid.Column="2" Content="Validate folder" Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock x:Name="TextSetupFolderStatus" Text="Choose a folder to begin." TextWrapping="Wrap" Foreground="#8F93A2" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Setup mode">
                            <StackPanel Margin="6">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RadioQuickMode" Content="Quick" IsChecked="True" Foreground="#ECEFF4" Margin="0,0,20,0"/>
                                    <RadioButton x:Name="RadioCustomMode" Content="Custom" Foreground="#ECEFF4" Margin="0,0,20,0"/>
                                    <RadioButton x:Name="RadioExpertMode" Content="Expert" Foreground="#ECEFF4"/>
                                </StackPanel>
                                <Border Background="#202334" Padding="10" Margin="0,8,0,0" CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock x:Name="TextQuickModeDetail" Text="Recommended path: inspect the folder, then review each requested change. Found controllers still need player assignment and calibration." TextWrapping="Wrap" Foreground="#8F93A2"/>
                                        <TextBlock x:Name="TextCustomModeDetail" Text="Review folder, device identity, player mapping, and manual calibration evidence one step at a time." TextWrapping="Wrap" Foreground="#8F93A2" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TextExpertModeDetail" Text="Expert details: target path and raw device instance IDs are shown for diagnosis. Device presence alone never sets a playable status." TextWrapping="Wrap" Foreground="#8F93A2" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Read-only device discovery">
                            <StackPanel Margin="6">
                                <TextBlock Text="Discovery reads Windows device information. A detected PnP device does not prove Bluetooth identity, player assignment, calibration, or that a gun is playable." TextWrapping="Wrap" Foreground="#FFB020" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="BtnRefreshDiscovery" Content="Refresh device discovery" Style="{StaticResource AccentButton}"/>
                                    <TextBlock x:Name="TextDiscoveryStatus" Text="Not checked" Foreground="#8F93A2" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="ListDiscoveredDevices" MinHeight="60" MaxHeight="180" Background="#0E1017" Foreground="#ECEFF4" BorderBrush="#2D3148"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Next steps">
                            <StackPanel Margin="6">
                                <TextBlock Text="Pairing is semi-automatic: follow the device's physical pairing steps, then refresh discovery and verify its identity and player mapping. If no stable Bluetooth MAC is available, assign the device manually; do not infer identity from its display name." TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBlock Text="Calibration is manual and guided. Complete a per-player aiming test after calibration. Opening a calibration tool alone does not count as success." TextWrapping="Wrap" Foreground="#8F93A2"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TAB 1: STATUS & HARDWARE -->
            <TabItem Header="Dashboard &amp; Status">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <!-- ECOSYSTEM HEALTH -->
                        <GroupBox Header="Hardware &amp; System Components Status">
                            <Grid Margin="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Column 1 -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <!-- Relay Status -->
                                    <Border Background="#202334" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotRelay" Width="10" Height="10" Fill="#FF5252" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="hotwm Relay Engine" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextRelayDetail" Text="Port 8000 listening: No" FontSize="11" Foreground="#8F93A2" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextRelayBadge" Text="OFFLINE" Foreground="#FF5252" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Gunmote Status -->
                                    <Border Background="#202334" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotGunmote" Width="10" Height="10" Fill="#FFB020" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Gunmote Process" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextGunmoteDetail" Text="Checking..." FontSize="11" Foreground="#8F93A2" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextGunmoteBadge" Text="UNKNOWN" Foreground="#FFB020" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- ViGEmBus Status -->
                                    <Border Background="#202334" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotVigem" Width="10" Height="10" Fill="#FFB020" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="ViGEmBus Controller Driver" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextVigemDetail" Text="Virtual Gamepad Bus" FontSize="11" Foreground="#8F93A2" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextVigemBadge" Text="UNKNOWN" Foreground="#FFB020" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Column 2 -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <!-- Wiimote / DolphinBar Status -->
                                    <Border Background="#202334" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotWiimote" Width="10" Height="10" Fill="#FFB020" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Wiimotes (Bluetooth / DolphinBar)" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextWiimoteDetail" Text="Bluetooth or DolphinBar" FontSize="11" Foreground="#8F93A2" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextWiimoteBadge" Text="UNKNOWN" Foreground="#FFB020" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Scheduled Task Autostart -->
                                    <Border Background="#202334" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotTask" Width="10" Height="10" Fill="#FFB020" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Windows Autostart Task" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextTaskDetail" Text="Task: Gunmote Recoil Stretch" FontSize="11" Foreground="#8F93A2" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextTaskBadge" Text="CHECKING" Foreground="#FFB020" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Kit Integration Status -->
                                    <Border Background="#202334" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="DotKit" Width="10" Height="10" Fill="#82AAFF" Margin="0,0,10,0" Grid.Column="0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Retro Cabinet Kit API" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock x:Name="TextKitDetail" Text="outputs.wiimote_hook (API 1.4+)" FontSize="11" Foreground="#8F93A2" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TextKitBadge" Text="CHECKING" Foreground="#82AAFF" FontWeight="Bold" Grid.Column="2" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- TASK & SYSTEM ACTIONS -->
                        <GroupBox Header="Quick Maintenance Actions">
                            <WrapPanel Margin="4">
                                <Button x:Name="BtnRefreshStatus" Content="⟳ Refresh Status" Margin="0,0,10,6"/>
                                <Button x:Name="BtnInstallTask" Content="⚙ Install Windows Task (Autostart)" Margin="0,0,10,6"/>
                                <Button x:Name="BtnUninstallTask" Content="✕ Remove Windows Task" Margin="0,0,10,6"/>
                                <Button x:Name="BtnQueryKit" Content="🔍 Query Kit Health" Style="{StaticResource AccentButton}" Margin="0,0,10,6"/>
                                <Button x:Name="BtnQueryInputMatrix" Content="🎮 Cabinet Input Matrix (Kit)" Style="{StaticResource AccentButton}" Margin="0,0,10,6"/>
                                <Button x:Name="BtnVerifyOutputSafety" Content="🛡 Output Safety Check (Kit)" Style="{StaticResource AccentButton}" Margin="0,0,10,6"/>
                            </WrapPanel>
                        </GroupBox>

                        <!-- HAPTIC TEST BENCH -->
                        <GroupBox Header="Live Wiimote Haptics Test Bench">
                            <StackPanel Margin="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Player 1 -->
                                    <Border Grid.Column="0" Background="#202334" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Player 1 (Main Gunmote)" FontWeight="Bold" Foreground="#00E5FF" FontSize="14" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnTestP1Rumble" Content="Send P1 recoil kick (rumble)" Style="{StaticResource AccentButton}" Margin="0,0,8,6"/>
                                                <Button x:Name="BtnTestP1Leds" Content="Cycle P1 LEDs 1 to 4" Margin="0,0,8,6"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Player 2 -->
                                    <Border Grid.Column="1" Background="#202334" CornerRadius="4" Padding="12" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Player 2 (Second Gunmote)" FontWeight="Bold" Foreground="#FF80BF" FontSize="14" Margin="0,0,0,8"/>
                                            <WrapPanel>
                                                <Button x:Name="BtnTestP2Rumble" Content="Send P2 recoil kick (rumble)" Style="{StaticResource AccentButton}" Margin="0,0,8,6"/>
                                                <Button x:Name="BtnTestP2Leds" Content="Cycle P2 LEDs 1 to 4" Margin="0,0,8,6"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                    <Button x:Name="BtnPingRelay" Content="📡 Ping Relay Socket (Port 8000)" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TextTestFeedback" Text="Ready to test haptics." FontSize="12" Foreground="#8F93A2" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB: EDITABLE EFFECT PROFILES -->
            <TabItem Header="Effects">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <GroupBox Header="Effect profile template">
                            <StackPanel Margin="6">
                                <TextBlock Text="Choose a shipped starting point, copy it into a named user profile, then edit the shared recoil controls and game settings in Recoil &amp; Profiles Tuning." TextWrapping="Wrap" Foreground="#8F93A2" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Shipped preset:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CmbEffectPreset" Grid.Column="1" MinWidth="240" DisplayMemberPath="Name" Padding="6,4"/>
                                </Grid>
                                <TextBlock x:Name="TextEffectPresetDescription" Text="Select a preset to see its description." TextWrapping="Wrap" Foreground="#8F93A2" Margin="0,8,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="User profile name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="TextEffectProfileName" Grid.Column="1" Text="My effects" Padding="8,5" Background="#0E1017" Foreground="#ECEFF4" BorderBrush="#3B4261"/>
                                </Grid>
                                <WrapPanel>
                                    <Button x:Name="BtnCopyEffectProfile" Content="Copy preset to user profile" Style="{StaticResource AccentButton}" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnImportEffectProfile" Content="Import user profile…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnExportEffectProfile" Content="Export user profile…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnOpenEffectTuning" Content="Edit shared effect values" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="TextEffectProfileStatus" Text="No user profile copied yet." TextWrapping="Wrap" Foreground="#8F93A2" Margin="0,4,0,8"/>
                                <Border Background="#202334" CornerRadius="4" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Supported scope" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>
                                        <TextBlock Text="Effects currently apply to hotwm's global and per-game settings only. They do not define per-player effects or confirm physical hardware output." TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="BtnApplyEffectProfile" Content="Apply profile to hotw.json…" Style="{StaticResource SuccessButton}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="What applying does">
                            <TextBlock Text="Apply creates one reviewed configuration proposal. The confirmation shows the target and edited values; declining leaves hotw.json unchanged. The shipped template remains read-only." TextWrapping="Wrap" Margin="6" Foreground="#8F93A2"/>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TAB: SEMANTIC BUTTON PROFILE -->
            <TabItem Header="Buttons">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <GroupBox Header="Button intent profile">
                            <StackPanel Margin="6">
                                <TextBlock Text="This editable checklist records intended controls such as Shoot or Reload. It does not bind a controller, write a game mapping, or claim hardware input is configured." TextWrapping="Wrap" Foreground="#FFB020" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Shipped template:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox x:Name="CmbButtonTemplate" Grid.Column="1" MinWidth="240" DisplayMemberPath="Name" Padding="6,4"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="User profile name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox x:Name="TextButtonProfileName" Grid.Column="1" Text="My button intents" Padding="8,5" Background="#0E1017" Foreground="#ECEFF4" BorderBrush="#3B4261"/>
                                </Grid>
                                <DataGrid x:Name="GridButtonIntents" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          Background="#181A26" RowBackground="#202334" AlternatingRowBackground="#25293E"
                                          Foreground="#ECEFF4" BorderBrush="#2D3148" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D3148" MaxHeight="260"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button x:Name="BtnCopyButtonProfile" Content="Copy template to user profile" Style="{StaticResource AccentButton}" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnImportButtonProfile" Content="Import user profile…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnExportButtonProfile" Content="Export user profile…" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock x:Name="TextButtonProfileStatus" Text="No button profile copied yet." TextWrapping="Wrap" Foreground="#8F93A2" Margin="0,4,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Current integration status">
                            <TextBlock Text="Button intents are stored as manual/Kit-profile notes. Mapping them to a controller or game is a separate integration step and is not performed here." TextWrapping="Wrap" Margin="6" Foreground="#8F93A2"/>
                        </GroupBox>
                        <GroupBox Header="Gunmote layout editor">
                            <StackPanel Margin="6">
                                <TextBlock Text="Edit the actual OnScreen and OffScreen mappings. Saving writes a layout file after review while Gunmote is closed; it does not switch the active layout or restart Gunmote." TextWrapping="Wrap" Foreground="#8F93A2" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Shipped layout:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="CmbGunmoteKind" Grid.Column="1" DisplayMemberPath="Title" Padding="6,4"/>
                                    <Button x:Name="BtnCopyGunmoteLayout" Grid.Column="2" Content="Copy preset" Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                                    <Button x:Name="BtnImportGunmoteLayout" Grid.Column="3" Content="Import layout…" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Layout title:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TextGunmoteTitle" Grid.Column="1" Padding="7,4" Background="#0E1017" Foreground="#ECEFF4" BorderBrush="#3B4261"/>
                                    <TextBox x:Name="TextGunmoteFileName" Grid.Column="2" Width="180" Text="menu_user.json" ToolTip="New JSON filename inside the Keymaps directory" Margin="8,0,0,0" Padding="7,4" Background="#0E1017" Foreground="#ECEFF4" BorderBrush="#3B4261"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Keymaps folder:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TextGunmoteKeymapsDir" Grid.Column="1" Padding="7,4" Background="#0E1017" Foreground="#ECEFF4" BorderBrush="#3B4261"/>
                                    <Button x:Name="BtnBrowseGunmoteKeymapsDir" Grid.Column="2" Content="Browse…" Margin="8,0,0,0"/>
                                </Grid>
                                <DataGrid x:Name="GridGunmoteMappings" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          Background="#181A26" RowBackground="#202334" AlternatingRowBackground="#25293E"
                                          Foreground="#ECEFF4" BorderBrush="#2D3148" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D3148" MaxHeight="360"/>
                                <TextBox x:Name="TextGunmotePreview" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="200" Visibility="Collapsed" Margin="0,8,0,0" Background="#0E1017" Foreground="#8F93A2" BorderBrush="#2D3148"/>
                                <TextBlock x:Name="TextGunmoteStatus" Text="Copy a shipped preset or import an existing layout to begin." TextWrapping="Wrap" Foreground="#8F93A2" Margin="0,8,0,4"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button x:Name="BtnSaveGunmoteLayout" Content="Review and save layout…" Style="{StaticResource SuccessButton}" Margin="0,0,8,6"/>
                                    <TextBox x:Name="TextGunmoteChooserPath" Width="250" ToolTip="Existing Keymaps.json file" Margin="0,0,8,6" Padding="7,4" Background="#0E1017" Foreground="#ECEFF4" BorderBrush="#3B4261"/>
                                    <Button x:Name="BtnBrowseGunmoteChooser" Content="Choose Keymaps.json…" Margin="0,0,8,6"/>
                                    <Button x:Name="BtnAddGunmoteChooser" Content="Separately add saved layout to chooser…" IsEnabled="False" Margin="0,0,8,6"/>
                                </WrapPanel>
                                <TextBlock Text="Chooser update only adds this saved filename to the chooser list. It does not select a layout or change Gunmote's active/default layout." TextWrapping="Wrap" Foreground="#8F93A2"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- TAB 2: CONFIGURATION & TUNING -->
            <TabItem Header="Recoil &amp; Profiles Tuning">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <!-- GLOBAL TUNING -->
                        <GroupBox Header="Global Pulse Stretching &amp; Engine Features">
                            <StackPanel Margin="6">
                                <!-- Recoil Stretch Slider -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Recoil Pulse Stretch Duration:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <Slider x:Name="SliderHoldMs" Grid.Column="1" Minimum="80" Maximum="300" Value="150" SmallChange="10" LargeChange="25" TickFrequency="10" IsSnapToTickEnabled="True"/>
                                    <Border Grid.Column="2" Background="#202334" CornerRadius="4" Padding="10,4" Margin="16,0,0,0">
                                        <TextBlock x:Name="TextHoldMsValue" Text="150 ms" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Stretches raw 16ms MAME recoil signals into a tactile kick that the Wiimote motor can physically reproduce." FontSize="11" Foreground="#8F93A2" Margin="0,0,0,14"/>

                                <Separator Background="#2D3148" Margin="0,0,0,12"/>

                                <!-- Toggles -->
                                <CheckBox x:Name="ChkAmmoDrop" Content="Ammo Drop Recoil Kick — triggers a tactile pulse when off-screen reload or magazine drops" IsChecked="True"/>
                                <CheckBox x:Name="ChkLedLifeBar" Content="Health Bar LEDs — maps player life dynamically across Wiimote LEDs 1 to 4" IsChecked="True"/>
                                <CheckBox x:Name="ChkTraceLog" Content="Trace Logging — logs every incoming and outgoing recoil event to recoil-stretch-trace.log" IsChecked="False"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- GAME PROFILES -->
                        <GroupBox Header="Per-Game Profiles (hotw.json)">
                            <StackPanel Margin="6">
                                <TextBlock Text="Customize recoil stretching and LED life bar behavior per arcade title:" FontSize="12" Foreground="#8F93A2" Margin="0,0,0,8"/>
                                <DataGrid x:Name="GridGameProfiles" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                          Background="#181A26" RowBackground="#202334" AlternatingRowBackground="#25293E"
                                          Foreground="#ECEFF4" BorderBrush="#2D3148" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#2D3148"
                                          MaxHeight="260" Margin="0,0,0,12">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#25293E"/>
                                            <Setter Property="Foreground" Value="#8F93A2"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="BorderBrush" Value="#2D3148"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Game / Title" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                                        <DataGridCheckBoxColumn Header="Recoil Rumble" Binding="{Binding Rumble}" Width="*"/>
                                        <DataGridCheckBoxColumn Header="LED Health Bar" Binding="{Binding Leds}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TextConfigSaveStatus" Text="" Foreground="#00E676" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <Button x:Name="BtnSaveConfig" Content="💾 Save Settings (Hot-Reloads Live)" Style="{StaticResource SuccessButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: LIVE LOG MONITOR -->
            <TabItem Header="Live Log Monitor">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Recoil Stretch &amp; Relay Event Trace:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <Button x:Name="BtnClearLog" Content="Clear" Margin="0,0,8,0"/>
                        <Button x:Name="BtnOpenLogFile" Content="Open Log File in Editor"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#0E1017" BorderBrush="#2D3148" BorderThickness="1" CornerRadius="4">
                        <TextBox x:Name="TextLogOutput" Background="Transparent" Foreground="#82AAFF"
                                 FontFamily="Consolas" FontSize="11" IsReadOnly="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 BorderThickness="0" Padding="8"/>
                    </Border>

                    <TextBlock Grid.Row="2" x:Name="TextLogFooter" Text="Logs are written to recoil-stretch-trace.log in the hotwm folder when trace logging is enabled." FontSize="11" Foreground="#8F93A2" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TextFooterInfo" Text="hotwm — Hook of the Wiimote • Standalone Engine &amp; Retro Cabinet Kit Extension" FontSize="11" Foreground="#8F93A2"/>
                <TextBlock Grid.Column="1" Text="TCP 8000 (Relay) → TCP 8002 (Upstream)" FontSize="11" Foreground="#8F93A2"/>
            </Grid>
        </Border>
    </Grid>
</Window>
