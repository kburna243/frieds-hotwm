<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Primitive palette: brand values and quiet neutral steps for dark surfaces. -->
    <Color x:Key="BrandNight">#0E1B23</Color>
    <Color x:Key="BrandCream">#F6F2E9</Color>
    <Color x:Key="BrandPixelGreen">#3DDC84</Color>
    <Color x:Key="BrandRetroRed">#FF4B3A</Color>
    <Color x:Key="BrandCrownGold">#FFC857</Color>
    <Color x:Key="NeutralSurface">#15262F</Color>
    <Color x:Key="NeutralElevated">#1B303A</Color>
    <Color x:Key="NeutralBorder">#35505B</Color>
    <Color x:Key="NeutralMutedText">#B8C2C2</Color>

    <!-- Semantic layer: views use purpose names instead of palette values. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BrandNight}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource NeutralSurface}" />
    <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource NeutralElevated}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource BrandCream}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource NeutralMutedText}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource NeutralBorder}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BrandPixelGreen}" />
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource BrandPixelGreen}" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource BrandCrownGold}" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource BrandRetroRed}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource BrandNight}" />

    <!-- Named component styles keep this dictionary opt-in for the existing dashboard. -->
    <Style x:Key="HotwmBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="HotwmSectionHeadingStyle" TargetType="TextBlock" BasedOn="{StaticResource HotwmBodyTextStyle}">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="HotwmCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="HotwmBaseButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="HotwmPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource HotwmBaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style x:Key="HotwmDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource HotwmBaseButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource StatusDangerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusDangerBrush}" />
    </Style>
</ResourceDictionary>
